DATABASE_URL=postgresql+asyncpg://crm:CHANGE_ME@evolution-go-postgres:5432/yesweigh_crm
SECRET_KEY=CHANGE_ME
ADMIN_EMAIL=admin@yesweigh.in
ADMIN_PASSWORD=Yesweigh@2026
EVOLUTION_BASE_URL=http://evolution-go:8080
EVOLUTION_API_KEY=
ADMS_BASE_URL=http://172.17.0.1:8081
# Optional comma-separated extras; built-in retired codes (1,2,4,5,7-13,15-17,21,55) always excluded
# ADMS_EXCLUDED_EMPLOYEE_CODES=
CORS_ORIGINS=https://crm.yesweigh.in,capacitor://localhost,http://localhost
APP_NAME=YesWeigh CRM
# Auth session: long-lived JWT (~6 months). New login revokes prior sessions for that user.
# ACCESS_TOKEN_EXPIRE_MINUTES=259200
# Durable Firebase access for yesweigh-service (VPS /opt/yesweigh-crm/.env only — never commit).
# Used by: catalog sync, Care Firestore backfill, Care settings callable, Care reply via
# sendWhatsAppCloudMessage (staff Firebase Auth). Prefer LOGIN_ID+PASSWORD (already working);
# optional service-account JSON is not required for current CRM paths.
# FIREBASE_LOGIN_ID=xxxxxxxxxxxx   # 12-digit Aadhaar → {digits}@yesweigh.auth
# FIREBASE_PASSWORD=
# FIREBASE_EMAIL=                  # optional instead of LOGIN_ID
# FIREBASE_API_KEY=AIzaSyBiLI--JR640YlXb2uiuBrLJ83XtFMPncE
# FIREBASE_PROJECT_ID=yesweigh-service
# CATALOG_IMAGE_DIR=/data/catalog-images
# DOWNLOAD_IMAGES=0   # keep 0 on cron / VPS (image download OOMs 512m API)
# See docs/catalog-sync.md

# Google Places Text Search — AI find_new_dealers / search_google_businesses + lead enrichment
# (VPS/local .env only — never commit real key). Either key works; Places API (New) must be enabled.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=
# Extra confirmation for WhatsApp instance delete (API + Settings UI). Default 1010 if unset.
# WHATSAPP_INSTANCE_DELETE_PASSWORD=1010
# AI Agent — Gemini (set GEMINI_API_KEY on server/local only; never commit real keys)
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=
# AI_ENABLED=true
# AI_MONTHLY_BUDGET_INR=500
# AI_DAILY_BUDGET_INR=25
# AI_MAX_OUTPUT_TOKENS=2048
# AI_WORKER_CONCURRENCY=2
# Live AI tool factory (Cursor Cloud Agents). Prefer CURSOR_FAISAL_API_KEY on VPS — never commit real keys.
# AI_TOOL_FACTORY_ENABLED=true
# AI_TOOL_FACTORY_TIMEOUT_S=90
# AI_RUN_TIMEOUT_S=180
# AI_RUN_STALE_S=600
# Skip re-sending identical WhatsApp text from same instance→phone (AI Agent send tools)
# WHATSAPP_SEND_DEDUP_HOURS=24
# AI_GENERATED_TOOLS_DIR=/data/ai-generated-tools
# CURSOR_FAISAL_API_KEY=
# CURSOR_API_KEY=
# Sarvam AI speech-to-text for WhatsApp voice notes (VPS/local .env only — never commit real key)
# SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe
# Final CRM transcript language (any spoken language → this script). Empty disables post-STT translate.
# SARVAM_TRANSCRIPT_TARGET_LANGUAGE=ml-IN
# SARVAM_TRANSLATE_MODEL=mayura:v1
# Care = YesOne Meta Cloud WhatsApp chip (secrets on VPS only — never commit)
# CARE_WEBHOOK_SECRET=          # optional shared secret for /api/webhooks/cloud-whatsapp
# CARE_META_VERIFY_TOKEN=       # Meta hub.verify_token for /api/webhooks/meta-whatsapp
# YESONE_CLOUD_WEBHOOK_URL=https://asia-south1-yesweigh-service.cloudfunctions.net/ingestWhatsAppCloudWebhook
# YESONE_CARE_SEND_URL=https://asia-south1-yesweigh-service.cloudfunctions.net/crmCareSendWhatsApp
# Replies prefer Firebase callable sendWhatsAppCloudMessage (uses FIREBASE_LOGIN_ID/PASSWORD).
# Optional direct Graph send:
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=1288718687667400
# WHATSAPP_CLOUD_GRAPH_VERSION=v21.0


