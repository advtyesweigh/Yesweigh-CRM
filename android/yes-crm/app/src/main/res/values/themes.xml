<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YesCrm" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/yes_blue</item>
        <item name="colorPrimaryDark">@color/yes_navy</item>
        <item name="colorAccent">@color/yes_blue</item>
        <item name="android:statusBarColor">@color/yes_status_bar</item>
        <item name="android:navigationBarColor">@color/yes_white</item>
        <item name="android:windowBackground">@color/yes_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="YesCrm.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemRippleColor">@color/yes_blue_soft</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/yes_white</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="YesCrm.NavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
