<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTELLIGENCE"
                    android:textAllCaps="true"
                    android:textColor="#77869B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="AI Agent"
                    android:textColor="@color/yes_ink"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your YesWeigh business assistant"
                    android:textColor="@color/yes_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_neutral"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="On-device demo"
                android:textColor="#62748D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chat_head"
            android:padding="17dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#33FFFFFF">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/yes_white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ask anything. Get work done."
                    android:textColor="@color/yes_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sales, dealers, service, stamping, attendance."
                    android:textColor="#CAD6F4"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/askMode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_mode_btn_active"
                android:gravity="center"
                android:text="Ask AI"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/yes_blue"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/taskMode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_mode_btn"
                android:gravity="center"
                android:text="Run task"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/yes_ink"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="vertical"
            android:minHeight="124dp" />

        <TextView
            android:id="@+id/aiPromptTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Suggested questions"
            android:textColor="@color/yes_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/aiPrompts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_composer"
            android:padding="8dp">

            <EditText
                android:id="@+id/aiInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Ask about your work…"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:padding="8dp"
                android:textSize="13sp"
                android:textColor="@color/yes_ink"
                android:importantForAutofill="no" />

            <FrameLayout
                android:id="@+id/btnSendAi"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_primary_btn"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:tint="@color/yes_white" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_notice"
            android:padding="12dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_shield"
                app:tint="#5372BD" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="AI works inside CRM only. Actions requiring approval are prepared for review. This build answers from local call/attendance context without calling live AI APIs."
                android:textColor="#65748A"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="AI tools"
            android:textColor="@color/yes_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="14dp">

            <include layout="@layout/item_feature_row"
                android:id="@+id/feat1" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2F6" />
            <include layout="@layout/item_feature_row"
                android:id="@+id/feat2" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2F6" />
            <include layout="@layout/item_feature_row"
                android:id="@+id/feat3" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2F6" />
            <include layout="@layout/item_feature_row"
                android:id="@+id/feat4" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
