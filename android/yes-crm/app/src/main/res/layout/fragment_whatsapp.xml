<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMMUNICATION"
            android:textAllCaps="true"
            android:textColor="#77869B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="WhatsApp"
            android:textColor="@color/yes_ink"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your usual WhatsApp application."
            android:textColor="@color/yes_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_wa_hero"
            android:padding="25dp">

            <FrameLayout
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_wa_logo">
                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_whatsapp"
                    app:tint="@color/yes_white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Open WhatsApp"
                android:textColor="@color/yes_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Continue your normal conversations with dealers and leads in WhatsApp."
                android:textColor="@color/yes_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnOpenWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_wa_btn"
                android:gravity="center"
                android:text="Open WhatsApp"
                android:textColor="@color/yes_white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_notice"
            android:padding="12dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_info"
                app:tint="#5372BD" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="No AI replies, transcription controls or CRM interface are added to WhatsApp itself. All AI tools are available separately inside YESWEIGH CRM."
                android:textColor="#65748A"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="Inside CRM"
            android:textColor="@color/yes_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="@drawable/bg_symbol_violet">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/yes_violet" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Agent"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/yes_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ask questions, prepare replies and run tasks."
                        android:textSize="11sp"
                        android:textColor="@color/yes_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/waOpenAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open"
                    android:textColor="@color/yes_blue"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:padding="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFF2F6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="@drawable/bg_symbol_green">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone_small"
                        app:tint="@color/yes_green" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call List"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/yes_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review synced phone call activity."
                        android:textSize="11sp"
                        android:textColor="@color/yes_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/waOpenCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open"
                    android:textColor="@color/yes_blue"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center"
            android:text="Launches the installed WhatsApp app on this phone."
            android:textColor="#7C8BA0"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
