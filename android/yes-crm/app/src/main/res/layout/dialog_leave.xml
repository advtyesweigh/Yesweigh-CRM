<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/yes_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply for leave"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/yes_ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Submit a request for manager approval"
                android:textColor="@color/yes_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseLeave"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_btn">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_x"
                app:tint="@color/yes_ink" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Leave type"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#43546E" />

    <Spinner
        android:id="@+id/leaveType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search"
        android:paddingHorizontal="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#43546E" />

            <EditText
                android:id="@+id/leaveFrom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:paddingHorizontal="10dp"
                android:inputType="date"
                android:hint="YYYY-MM-DD"
                android:textSize="13sp"
                android:importantForAutofill="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#43546E" />

            <EditText
                android:id="@+id/leaveTo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:paddingHorizontal="10dp"
                android:inputType="date"
                android:hint="YYYY-MM-DD"
                android:textSize="13sp"
                android:importantForAutofill="no" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Reason"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#43546E" />

    <EditText
        android:id="@+id/leaveReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search"
        android:gravity="top"
        android:padding="12dp"
        android:hint="Enter your reason"
        android:inputType="textMultiLine|textCapSentences"
        android:textSize="13sp"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/btnSubmitLeave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_primary_btn"
        android:gravity="center"
        android:text="Submit request"
        android:textColor="@color/yes_white"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
