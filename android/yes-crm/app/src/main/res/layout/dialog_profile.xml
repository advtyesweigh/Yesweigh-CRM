<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/yes_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/profileAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/yes_blue"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/yes_ink" />

            <TextView
                android:id="@+id/profileMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/yes_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnProfileClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/yes_blue"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/yes_line" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Business workspace: YesWeigh CRM"
        android:textColor="@color/yes_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Attendance source: ADMS (sample)"
        android:textColor="@color/yes_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Messaging: External WhatsApp"
        android:textColor="@color/yes_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/profileSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textStyle="bold"
        android:textColor="@color/yes_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/profileLastSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/yes_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnProfileBattery"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_icon_btn"
        android:gravity="center"
        android:text="@string/battery_unrestricted"
        android:textColor="@color/yes_blue"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProfileSyncToggle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_primary_btn"
        android:gravity="center"
        android:text="@string/stop_sync"
        android:textColor="@color/yes_white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProfileLogout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/sign_out"
        android:textColor="@color/yes_red"
        android:textStyle="bold" />
</LinearLayout>
